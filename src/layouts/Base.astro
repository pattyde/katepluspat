---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = "Kate and Pat's travel blog.", ogImage } = Astro.props;
const siteUrl = 'https://katepluspat.com';
const pageTitle = title === 'Kate + Pat' ? title : `${title} — Kate + Pat`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {ogImage && <meta property="og:image" content={`${siteUrl}${ogImage}`} />}

  <link rel="alternate" type="application/rss+xml" title="Kate + Pat" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header>
    <a href="/" class="site-title">Kate + Pat</a>
    <a href="/search/" class="search-link" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      Search
    </a>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>katepluspat.com</p>
  </footer>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --text: #1a1a1a;
    --text-muted: #666;
    --border: #e5e5e5;
    --bg: #fff;
    --accent: #2a5f8f;
    --max-width: 720px;
    --wide: 960px;
  }

  html { font-size: 18px; }

  body {
    font-family: 'Lora', Georgia, serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.7;
    padding: 0 1.25rem;
  }

  header {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 2rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-title {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }
  .site-title:hover { color: var(--accent); }

  .search-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .search-link:hover { color: var(--accent); }

  main {
    max-width: var(--wide);
    margin: 0 auto;
  }

  footer {
    max-width: var(--wide);
    margin: 4rem auto 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  h1, h2, h3 { font-family: 'Lora', Georgia, serif; line-height: 1.3; }

  a { color: var(--accent); }
  a:hover { text-decoration: none; }

  img { max-width: 100%; height: auto; display: block; }
</style>
