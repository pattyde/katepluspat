---
interface Props {
  countries: string[];
}
const { countries } = Astro.props;
---
<div id="trip-map"></div>

<script define:vars={{ countries }}>
  async function initMap() {
    // Load Leaflet dynamically
    const L = (await import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js')).default
      ?? (await import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js'));

    const CENTROIDS = {
      Thailand: [13.7, 100.5], Myanmar: [16.8, 96.2], Laos: [17.9, 102.6],
      Cambodia: [11.6, 104.9], Vietnam: [14.1, 108.3], Japan: [35.7, 139.7],
      China: [35.9, 104.2], Malaysia: [3.1, 101.7],
      'United Kingdom': [51.5, -0.1], UK: [51.5, -0.1], England: [51.5, -0.1],
      Scotland: [56.5, -4.2], France: [46.2, 2.2], Germany: [51.2, 10.5],
      Netherlands: [52.1, 5.3], Austria: [47.5, 13.3], Spain: [40.4, -3.7],
      Italy: [41.9, 12.5], Finland: [61.9, 25.7],
      USA: [37.1, -95.7], Peru: [-9.2, -75.0], Bolivia: [-16.3, -64.0],
      Argentina: [-34.6, -58.4], Brazil: [-14.2, -51.9], Australia: [-25.3, 133.8],
    };

    const coords = countries
      .map(c => CENTROIDS[c])
      .filter(Boolean);

    if (coords.length < 2) return;

    const map = L.map('trip-map', { scrollWheelZoom: false });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // Deduplicate consecutive same-country entries
    const deduped = coords.filter((c, i) =>
      i === 0 || c[0] !== coords[i - 1][0] || c[1] !== coords[i - 1][1]
    );

    L.polyline(deduped, { color: '#2a5f8f', weight: 2, opacity: 0.7 }).addTo(map);
    deduped.forEach(coord => {
      L.circleMarker(coord, { radius: 5, color: '#2a5f8f', fillColor: '#fff', fillOpacity: 1, weight: 2 }).addTo(map);
    });

    map.fitBounds(L.polyline(deduped).getBounds(), { padding: [24, 24] });
  }

  document.addEventListener('DOMContentLoaded', initMap);
</script>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  #trip-map {
    height: 320px;
    border-radius: 4px;
    border: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
