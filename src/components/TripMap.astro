---
import { CITY_COORDS } from '../data/city-coords';

interface Props {
  stops: { city: string; country: string; transport?: string; date_start?: string; date_end?: string }[];
}
const { stops } = Astro.props;

const stopData = stops
  .map(s => ({ city: s.city, country: s.country, transport: s.transport ?? null, date_start: s.date_start ?? null, date_end: s.date_end ?? null, coords: CITY_COORDS[s.city] ?? null }))
  .filter(s => s.coords != null);
---
<div id="trip-map"></div>
<div id="trip-map-stats"></div>

<script define:vars={{ stopData }}>
  const TRANSPORT_STYLES = {
    fly:   { dashArray: '6 6',     weight: 2, opacity: 0.6, label: 'Plane'  },
    drive: { dashArray: null,      weight: 2, opacity: 0.7, label: 'Drive'  },
    train: { dashArray: '2 6',     weight: 2, opacity: 0.7, label: 'Train'  },
    ferry: { dashArray: '8 4 2 4', weight: 2, opacity: 0.7, label: 'Ferry'  },
    bus:   { dashArray: '4 4',     weight: 2, opacity: 0.7, label: 'Bus'    },
    walk:  { dashArray: '1 5',     weight: 2, opacity: 0.8, label: 'Walk'   },
  };

  function arcPoints(a, b, steps = 50) {
    const mx = (a[0] + b[0]) / 2;
    const my = (a[1] + b[1]) / 2;
    const dx = b[0] - a[0];
    const dy = b[1] - a[1];
    const len = Math.sqrt(dx * dx + dy * dy);
    const offset = len * 0.25;
    const cx = mx - dy / len * offset;
    const cy = my + dx / len * offset;
    return Array.from({ length: steps + 1 }, (_, i) => {
      const t = i / steps;
      return [
        (1-t)**2 * a[0] + 2*(1-t)*t * cx + t**2 * b[0],
        (1-t)**2 * a[1] + 2*(1-t)*t * cy + t**2 * b[1],
      ];
    });
  }

  function haversineKm([lat1, lon1], [lat2, lon2]) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  function formatPopup(stop) {
    let html = `<strong>${stop.city}</strong><br><span style="color:#666;font-size:0.85em">${stop.country}</span>`;
    if (stop.date_start) {
      const fmt = d => new Date(d + 'T00:00:00').toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
      html += `<br><span style="color:#666;font-size:0.85em">${stop.date_end && stop.date_end !== stop.date_start ? fmt(stop.date_start) + ' – ' + fmt(stop.date_end) : fmt(stop.date_start)}</span>`;
    }
    return html;
  }

  async function initMap() {
    if (stopData.length < 2) return;

    const L = (await import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js')).default
      ?? (await import('https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js'));

    const map = L.map('trip-map', { scrollWheelZoom: false });
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> © <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // Deduplicate consecutive identical coordinates
    const deduped = stopData.filter((s, i) =>
      i === 0 || s.coords[0] !== stopData[i - 1].coords[0] || s.coords[1] !== stopData[i - 1].coords[1]
    );

    // Draw one polyline per leg, styled by transport mode
    for (let i = 1; i < deduped.length; i++) {
      const style = TRANSPORT_STYLES[deduped[i].transport] ?? TRANSPORT_STYLES.drive;
      const points = deduped[i].transport === 'fly'
        ? arcPoints(deduped[i - 1].coords, deduped[i].coords)
        : [deduped[i - 1].coords, deduped[i].coords];
      L.polyline(points, { color: '#2a5f8f', ...style }).addTo(map);
    }

    // Draw clickable markers with popups
    deduped.forEach(stop => {
      L.circleMarker(stop.coords, { radius: 5, color: '#2a5f8f', fillColor: '#fff', fillOpacity: 1, weight: 2 })
        .bindPopup(formatPopup(stop), { maxWidth: 180 })
        .addTo(map);
    });

    map.fitBounds(L.polyline(deduped.map(s => s.coords)).getBounds(), { padding: [24, 24] });

    // Legend — only show modes actually used in this trip
    const usedModes = [...new Set(deduped.slice(1).map(s => s.transport).filter(Boolean))];
    if (usedModes.length > 0) {
      const legend = L.control({ position: 'bottomleft' });
      legend.onAdd = () => {
        const div = L.DomUtil.create('div', 'trip-legend');
        div.innerHTML = usedModes.map(mode => {
          const style = TRANSPORT_STYLES[mode] ?? TRANSPORT_STYLES.car;
          const dash = style.dashArray
            ? `stroke-dasharray="${style.dashArray.split(' ').map((v, i) => i === 0 ? v : v).join(' ')}"`
            : '';
          const lineEl = mode === 'fly'
            ? `<path d="M0,9 Q14,0 28,9" fill="none" stroke="#2a5f8f" stroke-width="2" stroke-dasharray="6 6" />`
            : `<line x1="0" y1="5" x2="28" y2="5" stroke="#2a5f8f" stroke-width="2" ${dash} />`;
          return `<div class="trip-legend-row">
            <svg width="28" height="10" viewBox="0 0 28 10">
              ${lineEl}
            </svg>
            <span>${style.label}</span>
          </div>`;
        }).join('');
        return div;
      };
      legend.addTo(map);
    }

    // Calculate and display total distance
    const totalKm = deduped.reduce((sum, s, i) => i === 0 ? 0 : sum + haversineKm(deduped[i - 1].coords, s.coords), 0);
    document.getElementById('trip-map-stats').textContent = `Total distance: ${Math.round(totalKm).toLocaleString()} km`;
  }

  document.addEventListener('DOMContentLoaded', initMap);
</script>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  #trip-map {
    height: 320px;
    border-radius: 4px;
    border: 1px solid var(--border);
    margin: 2rem 0 0.5rem;
  }

  #trip-map-stats {
    font-family: 'Inter', sans-serif;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: right;
    margin-bottom: 1.5rem;
  }

  :global(.trip-legend) {
    background: white;
    padding: 0.4rem 0.6rem;
    border-radius: 3px;
    border: 1px solid var(--border);
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    color: var(--text);
    line-height: 1;
  }

  :global(.trip-legend-row) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0;
  }
</style>
