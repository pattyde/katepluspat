---
interface Props {
  title: string;
  subtitle?: string;
  slug: string;
  dateRange: string;
  countries: string[];
  postCount: number;
  heroImage?: string;
  summary?: string;
}
const { title, subtitle, slug, dateRange, countries, postCount, heroImage, summary } = Astro.props;
---
<a href={`/${slug}/`} class="trip-card">
  {heroImage && <img src={heroImage} alt={title} class="hero" />}
  <div class="body">
    <h2>{title}</h2>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <p class="meta">{dateRange} &middot; {postCount} {postCount === 1 ? 'post' : 'posts'}</p>
    <p class="countries">{countries.join(', ')}</p>
    {summary && <p class="summary">{summary}</p>}
  </div>
</a>

<style>
  .trip-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .trip-card:hover { border-color: var(--accent); }

  .hero { width: 100%; height: 240px; object-fit: cover; }

  .body { padding: 1.5rem; }
  .body h2 { font-size: 1.3rem; margin-bottom: 0.2rem; }

  .subtitle {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .meta {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .countries {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .summary { font-size: 0.95rem; }
</style>
